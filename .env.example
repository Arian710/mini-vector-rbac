# Kopieren zu ".env" und mit echten Werten aus dem Azure Portal befuellen.
# ".env" ist in .gitignore und wird NIE committet.
#
# Ohne diese Werte faellt embeddings.py automatisch auf den kostenlosen
# HashingEmbedder zurueck - das Projekt laeuft also auch ohne Azure-Account.

AZURE_OPENAI_ENDPOINT=https://dein-ressourcenname.openai.azure.com/
AZURE_OPENAI_API_KEY=dein-key-hier
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=embedding-deployment

# Optional: Azure AI Document Intelligence fuer OCR bei PDFs ohne Text-Ebene
# (gescannte/fotografierte Seiten). Ohne diese Werte wird bei solchen PDFs
# einfach "kein Text extrahiert" gemeldet statt OCR zu versuchen.
AZURE_DOCINTEL_ENDPOINT=https://dein-docintel-ressourcenname.cognitiveservices.azure.com/
AZURE_DOCINTEL_API_KEY=dein-key-hier

# Geheimer Schluessel zum Signieren/Pruefen von JWTs. Lokal: irgendein langer,
# zufaelliger String. In echtem Betrieb: aus einem Secret-Manager, nie fest im Code.
JWT_SECRET_KEY=ein-langer-zufaelliger-string-hier

# Azure Database for PostgreSQL - ersetzt die urspruengliche lokale SQLite-
# Datei, weil Azure App Service keinen garantiert persistenten lokalen
# Dateispeicher bietet (siehe storage.py).
AZURE_POSTGRES_HOST=dein-servername.postgres.database.azure.com
AZURE_POSTGRES_USER=dein-admin-user
AZURE_POSTGRES_PASSWORD=dein-passwort-hier
AZURE_POSTGRES_DB=vectorrbac
